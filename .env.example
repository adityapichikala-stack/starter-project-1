# Copy this file to .env and fill in real values. Never commit .env.
AZURE_OPENAI_ENDPOINT=https://your-resource-name.openai.azure.com/
AZURE_OPENAI_API_KEY=your-api-key-here
AZURE_OPENAI_API_VERSION=2024-10-21
AZURE_OPENAI_DEPLOYMENT=your-deployment-name
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=text-embedding-3-small

# SP2 pricing and quote rules
DISCOUNT_TIERS=200:12,50:8,10:5,1:0
FREE_DELIVERY_THRESHOLD=50000
DELIVERY_CHARGE=1500
QUOTE_VALIDITY_DAYS=7

# Postgres (docker-compose.yml)
POSTGRES_USER=orders
POSTGRES_PASSWORD=orders
POSTGRES_DB=orders
POSTGRES_HOST=localhost
POSTGRES_PORT=5433

# Workflow
LEAD_TIME_DAYS=3
LOG_LEVEL=INFO
EXTRACTION_MAX_ITERATIONS=5

# Optional cost-estimation rates per 1 million tokens. Leave unset until configured
# from your Azure deployment/pricing source; reported costs are estimates, not bills.
# LLM_INPUT_COST_PER_1M_TOKENS=
# LLM_OUTPUT_COST_PER_1M_TOKENS=

# Optional: folder holding the SP2 data pack (docs/, emails/, answer_key.json). Default: ./starter-project-2-data
# SP2_DATA_DIR=starter-project-2-data
