<mxfile host="app.diagrams.net">
  <diagram name="SP2 flow" id="sp2flow">
    <mxGraphModel dx="1200" dy="700" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" page="1" pageScale="1" pageWidth="1600" pageHeight="700" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="title" value="SP2 Order Desk: 6 steps (blue = LLM, green = Code, orange = RAG; thick border = new in SP2)" style="text;html=1;fontSize=16;fontStyle=1;align=left;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="900" height="30" as="geometry"/></mxCell>
        <mxCell id="email" value="Raw email&lt;br&gt;POST /orders" style="shape=document;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="20" y="270" width="100" height="70" as="geometry"/></mxCell>
        <mxCell id="s1" value="&lt;b&gt;1 Extract&lt;/b&gt;&lt;br&gt;LLM + code cross-check&lt;br&gt;max 5 iterations&lt;br&gt;&lt;i&gt;ExtractedOrder&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="160" y="250" width="150" height="110" as="geometry"/></mxCell>
        <mxCell id="s2" value="&lt;b&gt;2 Resolve products&lt;/b&gt; (NEW)&lt;br&gt;exact name, order history,&lt;br&gt;RAG description match&lt;br&gt;&lt;i&gt;ResolvedItem[]&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=4;" vertex="1" parent="1"><mxGeometry x="350" y="250" width="170" height="110" as="geometry"/></mxCell>
        <mxCell id="s3" value="&lt;b&gt;3 Validate&lt;/b&gt;&lt;br&gt;Code&lt;br&gt;fields, quantities, deadline&lt;br&gt;&lt;i&gt;ValidationResult&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="560" y="250" width="150" height="110" as="geometry"/></mxCell>
        <mxCell id="s4" value="&lt;b&gt;4 Check stock&lt;/b&gt;&lt;br&gt;Code&lt;br&gt;compare + status&lt;br&gt;Ready / Partial / Need info" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="750" y="250" width="150" height="110" as="geometry"/></mxCell>
        <mxCell id="s5" value="&lt;b&gt;5 Build quote&lt;/b&gt; (NEW)&lt;br&gt;Code, Decimal ROUND_HALF_UP&lt;br&gt;tier discount, delivery,&lt;br&gt;valid_until&lt;br&gt;&lt;i&gt;Quote or null&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=4;" vertex="1" parent="1"><mxGeometry x="940" y="250" width="170" height="110" as="geometry"/></mxCell>
        <mxCell id="s6" value="&lt;b&gt;6 Draft reply&lt;/b&gt;&lt;br&gt;LLM, then code reply check&lt;br&gt;fallback template" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="1150" y="250" width="160" height="110" as="geometry"/></mxCell>
        <mxCell id="out" value="OrderResult&lt;br&gt;status, items, issues,&lt;br&gt;quote, reply" style="shape=document;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="1350" y="265" width="130" height="80" as="geometry"/></mxCell>
        <mxCell id="pg" value="Postgres&lt;br&gt;products, stock,&lt;br&gt;order_history" style="shape=cylinder3;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="600" y="450" width="120" height="90" as="geometry"/></mxCell>
        <mxCell id="docs" value="documents (pgvector)&lt;br&gt;brochure + policy chunks&lt;br&gt;embedding vector(1536)" style="shape=cylinder3;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="330" y="450" width="170" height="90" as="geometry"/></mxCell>
        <mxCell id="ing" value="scripts/ingest_docs.py&lt;br&gt;prefix, batch embed, 1536 check" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="300" y="580" width="230" height="50" as="geometry"/></mxCell>
        <mxCell id="llmr" value="LLM picks from candidate codes only;&lt;br&gt;code drops anything else:&lt;br&gt;1 = resolved, 2+ = ambiguous, 0 = unknown" style="shape=note;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="330" y="90" width="230" height="80" as="geometry"/></mxCell>
        <mxCell id="pol" value="top 3 policy chunks +&lt;br&gt;item chunks to the reply" style="shape=note;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="1090" y="110" width="200" height="60" as="geometry"/></mxCell>
        <mxCell id="e0" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;html=1;" edge="1" parent="1" source="email" target="s1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e1" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;html=1;" edge="1" parent="1" source="s1" target="s2"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e2" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;html=1;" edge="1" parent="1" source="s2" target="s3"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e3" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;html=1;" edge="1" parent="1" source="s3" target="s4"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e4" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;html=1;" edge="1" parent="1" source="s4" target="s5"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e5" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;html=1;" edge="1" parent="1" source="s5" target="s6"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e6" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;html=1;" edge="1" parent="1" source="s6" target="out"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e7" value="vector search (&amp;lt;=&amp;gt;)" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;html=1;dashed=1;" edge="1" parent="1" source="s2" target="docs"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e8" value="history, catalogue" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;html=1;dashed=1;" edge="1" parent="1" source="s2" target="pg"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e9" value="stock, prices" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;html=1;dashed=1;" edge="1" parent="1" source="s4" target="pg"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e10" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;html=1;dashed=1;" edge="1" parent="1" source="ing" target="docs"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e11" style="edgeStyle=orthogonalEdgeStyle;endArrow=none;html=1;dashed=1;" edge="1" parent="1" source="llmr" target="s2"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e12" style="edgeStyle=orthogonalEdgeStyle;endArrow=none;html=1;dashed=1;" edge="1" parent="1" source="pol" target="s6"><mxGeometry relative="1" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
